# ============================================================
#  WPTC Retreat Centre — Environment Variables
#  Copy this file to .env and fill in your actual values
#  cp .env.example .env
# ============================================================

# ── SUPABASE (Required for database + auth) ──────────────────
# 1. Go to https://supabase.com → sign in → select your project
# 2. Go to Settings → API (left sidebar)
# 3. Copy "Project URL" and "anon public" key below
# 4. Copy "service_role secret" key (click "Reveal" to see it)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ── PAYSTACK (Required for online payments) ──────────────────
# 1. Go to https://dashboard.paystack.com → sign in
# 2. Go to Settings → API Keys & Webhooks
# 3. Copy your "Test Public Key" (starts with pk_test_)
# 4. Copy your "Test Secret Key" (starts with sk_test_)
# 5. When ready for production, switch to live keys (pk_live_ / sk_live_)
# 6. Add webhook URL: https://yourdomain.com/api/webhooks/paystack

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# ── HUBTEL SMS (Required for SMS notifications) ──────────────
# 1. Go to https://developers.hubtel.com → sign in
# 2. Go to Apps → select your app (or create one)
# 3. Copy the "Client ID" and "Client Secret"
# 4. For SENDER_ID: Go to SMS → Sender IDs → register "WPTC"
#    (This is the name that shows when guests receive your SMS)

HUBTEL_CLIENT_ID=your-hubtel-client-id
HUBTEL_CLIENT_SECRET=your-hubtel-client-secret
HUBTEL_SENDER_ID=WPTC

# ── APP CONFIG ───────────────────────────────────────────────
# Change NEXT_PUBLIC_APP_URL to your Vercel domain in production

NEXT_PUBLIC_APP_NAME="WPTC Management"
NEXT_PUBLIC_APP_URL=http://localhost:3000
